{
  "family": "hr-app-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::805982516676:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::805982516676:role/hr-app-task-role",
  "containerDefinitions": [
    {
      "name": "hr-app",
      "image": "805982516676.dkr.ecr.eu-west-2.amazonaws.com/hr-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "80" },
        { "name": "APP_URL", "value": "https://am-service.co.uk" },
        { "name": "ADMIN_EMAIL", "value": "allayanmalik@gmail.com" },
        { "name": "AWS_REGION", "value": "eu-west-2" },
        { "name": "S3_BUCKET_NAME", "value": "hr-app-docs-1892298022" },
        { "name": "DB_HOST", "value": "hr-portal-db.c5m4oagyag9k.eu-west-2.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_USER", "value": "postgres" },
        { "name": "DB_NAME", "value": "postgres" },
        { "name": "SMTP_HOST", "value": "smtp.gmail.com" },
        { "name": "SMTP_PORT", "value": "587" },
        { "name": "SMTP_SECURE", "value": "false" },
        { "name": "SMTP_USER", "value": "hrtest12647@gmail.com" },
        { "name": "SMTP_FROM", "value": "hrtest12647@gmail.com" }
      ],
     "secrets": [
      { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-west-2:805982516676:secret:hr-app/db-password-oBknhJ:password::" },
      { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-west-2:805982516676:secret:hr-app/jwt-secret-BTqzKe:value::" },
      { "name": "ADMIN_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-west-2:805982516676:secret:hr-app/admin-password-XVUwJY:value::" },
      { "name": "SMTP_PASS", "valueFrom": "arn:aws:secretsmanager:eu-west-2:805982516676:secret:hr-app/smtp-password-93sThY:value::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/hr-app",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
